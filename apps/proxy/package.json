{
  "name": "@x4g4t/proxy",
  "version": "0.1.0",
  "description": "Zero-latency, headless policy firewall and Data Leakage Prevention (DLP) proxy for AI agents and Model Context Protocol (MCP) servers.",
  "keywords": [
    "mcp-proxy",
    "agent-guardrails",
    "dlp-proxy",
    "ai-agent-security",
    "model-context-protocol",
    "rate-limiting"
  ],
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ml": "tsx watch src/ml-server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:ml": "node dist/ml-server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@x4g4t/db": "workspace:*",
    "@x4g4t/policy-engine": "workspace:*",
    "bullmq": "^6.3.8",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@x4g4t/tsconfig": "workspace:*",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}

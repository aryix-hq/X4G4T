# ==============================================================================
# X4G4T Environment Configuration Template (.env.example)
# Ultra-low-latency (<15ms) Policy & Audit Firewall for Autonomous AI Agents
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & DATABASE
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (Neon, Supabase, AWS RDS, or local Postgres)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/x4g4t"

# Redis connection string (Upstash, AWS ElastiCache, or local Redis)
# Note: For zero-Redis serverless Vercel demo deployments, this is optional.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. IDENTITY & ACCESS MANAGEMENT (IAM) CONFIGURATION
# ------------------------------------------------------------------------------
# Select active IAM Provider for authentication & session resolution:
# Options: "auto" | "clerk" | "workos" | "oidc" | "cognito" | "azure_ad" | "local"
# Default: "auto" (auto-detects based on available environment variables)
IAM_PROVIDER="auto"

# Fallback / Dev Admin User ID (used in local development when no IAM is configured)
DEFAULT_USER_ID="usr_dev_admin"

# --- Provider 1: Clerk IAM ---
# https://clerk.com/docs
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Optional: Explicit issuer domain, JWT verification key, or cookie encryption key
CLERK_JWT_KEY=""
CLERK_ENCRYPTION_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_FORCE_REDIRECT_URL="/dashboard"
# Note: Self-registration (/sign-up) is strictly disabled in X4G4T enterprise security proxy.

# --- Provider 2: WorkOS (Enterprise SSO, SAML 2.0, Directory Sync) ---
# https://workos.com/docs
WORKOS_API_KEY="sk_live_..."
WORKOS_CLIENT_ID="client_..."
WORKOS_ISSUER="https://api.workos.com"
WORKOS_REDIRECT_URI="http://localhost:3000/api/auth/callback/workos"
WORKOS_COOKIE_PASSWORD="32-character-minimum-random-secret-key-here"

# --- Provider 3: Okta / Auth0 / Generic OpenID Connect (OIDC) ---
# Supports standard OIDC JWT Bearer tokens with JWKS / Issuer verification
OIDC_ISSUER_URL="https://auth.yourcompany.com/oauth2/default"
OIDC_CLIENT_ID="x4g4t-gateway-client"
OIDC_CLIENT_SECRET="your-oidc-client-secret"
OIDC_AUDIENCE="https://api.x4g4t.internal"
OIDC_JWKS_URI="https://auth.yourcompany.com/oauth2/default/v1/keys"

# --- Provider 4: AWS IAM / Amazon Cognito User Pools ---
# https://docs.aws.amazon.com/cognito/
AWS_COGNITO_USER_POOL_ID="us-east-1_abcdef123"
AWS_COGNITO_CLIENT_ID="1234567890abcdefghijklmnop"
AWS_COGNITO_REGION="us-east-1"

# --- Provider 5: Azure Active Directory / Microsoft Entra ID ---
# https://learn.microsoft.com/en-us/entra/identity/
AZURE_AD_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_AD_CLIENT_ID="11111111-1111-1111-1111-111111111111"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
AZURE_AD_AUTHORITY="https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000"

# ------------------------------------------------------------------------------
# 3. HUMAN-IN-THE-LOOP (HITL) NOTIFICATIONS & APPROVALS
# ------------------------------------------------------------------------------
# Slack Incoming Webhook for approval cards
SLACK_HITL_WEBHOOK_URL=""

# Secret used to sign and verify Slack interactive payload HMAC signatures
SLACK_SIGNING_SECRET="your-slack-signing-secret-here"

# --- SMTP Server Configuration for Admin Approval Emails ---
# Host (e.g. smtp.gmail.com, smtp.sendgrid.net, localhost)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="X4G4T Security <no-reply@x4g4t.internal>"
ADMIN_EMAIL="admin@enterprise.internal"
PORTAL_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. EXTERNAL LOG SERVICE PROVIDERS & ANALYTICS
# ------------------------------------------------------------------------------
# --- Elasticsearch / OpenSearch Integration ---
ELASTICSEARCH_URL=""
ELASTICSEARCH_INDEX="x4g4t-logs"
ELASTICSEARCH_API_KEY=""
# Or Basic Auth:
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_PASSWORD=""

# --- Generic External Log Webhook (Datadog, Splunk, Logstash, Loki) ---
EXTERNAL_LOG_WEBHOOK_URL=""
EXTERNAL_LOG_AUTH_HEADER=""

# ------------------------------------------------------------------------------
# 5. UPSTREAM LLM PROVIDER CREDENTIALS & VAULT
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"


